{
  "name": "ts-implscan",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-registry.ts && node scripts/generate-registry.ts --target angular --out src/generated/registry.angular.ts",
    "generate:dry": "node scripts/generate-registry.ts --dry-run",
    "generate:dry:angular": "node scripts/generate-registry.ts --target angular --dry-run",
    "prestart": "npm run generate",
    "start": "node src/main.ts",
    "prestart:angular": "npm run generate",
    "start:angular": "node src/main-angular.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@angular/core": "^22.2.4",
    "@types/node": "^26.6.6",
    "rxjs": "^7.8.2",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  }
}
