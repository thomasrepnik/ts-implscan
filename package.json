{
  "name": "@thomasrepnik/ts-implscan",
  "version": "0.1.3",
  "description": "Spring-style List<PaymentHandler> injection for TypeScript: find every class implementing a marked interface and generate a typed registry, plus Angular InjectionTokens and providers.",
  "keywords": [
    "typescript",
    "dependency-injection",
    "angular",
    "multi-provider",
    "injection-token",
    "code-generation",
    "ts-morph",
    "spring",
    "component-scan"
  ],
  "homepage": "https://github.com/thomasrepnik/ts-implscan#readme",
  "bugs": {
    "url": "https://github.com/thomasrepnik/ts-implscan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasrepnik/ts-implscan.git"
  },
  "license": "MIT",
  "author": "Thomas Repnik",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "ts-implscan": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/generator.spec.ts example/dispatcher.spec.ts",
    "generate": "node src/cli.ts --src example --out example/generated/implscan-registry.ts && node src/cli.ts --src example --target angular --out example/generated/implscan-registry.angular.ts",
    "generate:dry": "node src/cli.ts --src example --dry-run",
    "generate:dry:angular": "node src/cli.ts --src example --target angular --dry-run",
    "prestart": "npm run generate",
    "start": "node example/main.ts",
    "prestart:angular": "npm run generate",
    "start:angular": "node example/main-angular.ts",
    "test:package": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@angular/core": "^22.2.4",
    "@types/node": "^26.6.6",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  }
}
